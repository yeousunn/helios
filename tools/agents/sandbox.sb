;; macOS sandbox base for one unattended agent cycle.
;; run-agent.sh appends the per-agent repository rules (which directories this
;; agent owns) and runs: sandbox-exec -f <control>/sandbox-<agent>.sb
;; Parameters: HOME, CTRL (the supervisor's control directory).
;;
;; Everything under HOME is read-only except the toolchain and opencode
;; caches, the control directory is read-only, and ~/.ssh is unreadable.
;; Later rules win.
(version 1)
(allow default)

(deny file-write* (subpath (param "HOME")))
(allow file-write*
    (subpath (string-append (param "HOME") "/.cargo"))
    (subpath (string-append (param "HOME") "/.rustup"))
    (subpath (string-append (param "HOME") "/.local/share/opencode"))
    (subpath (string-append (param "HOME") "/.local/state/opencode"))
    (subpath (string-append (param "HOME") "/.cache"))
    (subpath (string-append (param "HOME") "/Library/Caches")))

(deny file-write* (subpath (param "CTRL")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.ssh")))

;; ---- per-agent repository rules follow (generated) ----
